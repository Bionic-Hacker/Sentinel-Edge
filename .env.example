# SentinelEdge local environment — PLACEHOLDERS ONLY.
# Copy to .env (git-ignored) and replace every CHANGE_ME value.
# Production secrets come from AWS Secrets Manager (Phase 4), never from this file.

# --- Application ---
SENTINEL_ENVIRONMENT=local            # local | test | dev | staging | production
SENTINEL_LOG_LEVEL=INFO
SENTINEL_APP_VERSION=0.1.0
SENTINEL_ENABLE_API_DOCS=true         # forced false outside local/test
SENTINEL_TRUSTED_HOSTS=localhost,127.0.0.1,api

# --- Local PostgreSQL (docker-compose only) ---
POSTGRES_DB=sentineledge
POSTGRES_USER=sentinel_app
POSTGRES_PASSWORD=CHANGE_ME_local_only_password

# --- AI provider (Phase 9; documented, not used in Phase 1) ---
# Selected provider: Amazon Bedrock. Auth is via the ECS task IAM role — no API key exists.
SENTINEL_AI_PROVIDER=disabled         # disabled | offline | bedrock
SENTINEL_AWS_REGION=us-east-1
