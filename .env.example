# SentinelEdge local environment — PLACEHOLDERS ONLY.
# Run `make env` to create .env (git-ignored, mode 600): every CHANGE_ME value is replaced with a
# different random secret. Production secrets come from AWS Secrets Manager (Phase 4).

# --- Application ---
SENTINEL_ENVIRONMENT=local            # local | test | dev | staging | production
SENTINEL_LOG_LEVEL=INFO
SENTINEL_ENABLE_API_DOCS=true         # forced false outside local/test
SENTINEL_TRUSTED_HOSTS=localhost,127.0.0.1,api

# --- Local PostgreSQL (docker-compose only) ---
# Three identities, each given only to the container that needs it (ADR-0015):
#   POSTGRES_USER          admin: used once by the db container to create the roles below
#   sentinel_migrator      schema owner: used only by the one-shot `migrate` container
#   sentinel_app           runtime: the only database identity the API container receives
POSTGRES_DB=sentineledge
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=CHANGE_ME_admin
SENTINEL_DB_MIGRATOR_PASSWORD=CHANGE_ME_migrator
SENTINEL_DB_APP_PASSWORD=CHANGE_ME_app

# --- Authentication (ADR-0003) ---
# Only the API container receives these. Rotating the signing key signs everyone out; rotating
# the MFA key makes enrolled authenticators unreadable (re-enrollment required).
SENTINEL_JWT_SIGNING_KEY=CHANGE_ME_jwt_signing_key
SENTINEL_MFA_ENCRYPTION_KEY=CHANGE_ME_FERNET_mfa_key
# Origins allowed to call the cookie-based auth endpoints (CSRF defense). First = canonical.
SENTINEL_PUBLIC_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (Phase 9; documented, not used yet) ---
# Selected provider: Amazon Bedrock. Auth is via the ECS task IAM role — no API key exists.
SENTINEL_AI_PROVIDER=disabled         # disabled | offline | bedrock
SENTINEL_AWS_REGION=us-east-1
